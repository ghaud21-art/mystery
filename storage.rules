rules_version = '2';

// 사건 탭 게임(놓친 장면)의 영상·이미지. 업로드는 관리자만, 목록/직접 읽기는 전부 차단.
// 플레이어는 Cloud Functions가 "조건을 만족한 단계에서만" 내려주는 다운로드 주소(토큰 포함)로만 재생한다.
service firebase.storage {
  match /b/{bucket}/o {
    match /case-games/{gameId}/{file=**} {
      allow read: if false;
      allow write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true &&
        request.resource.size < 100 * 1024 * 1024;
    }
  }
}
