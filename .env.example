# Firebase 콘솔 > 프로젝트 설정 > 일반 > "내 앱" > SDK 설정에서 복사
# 실제 값을 넣은 뒤 이 파일을 .env 로 복사해서 사용하세요 (커밋 금지)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Gemini API (Firebase AI Logic 사용 시에는 불필요 — 직접 REST 호출할 때만)
VITE_GEMINI_API_KEY=

# Firebase 콘솔 > 프로젝트 설정 > 클라우드 메시징 > 웹 구성 > 웹 푸시 인증서(키 쌍 생성)
VITE_FIREBASE_VAPID_KEY=

# Firebase 콘솔 > Build > App Check > 웹 앱 등록 > reCAPTCHA v3 사이트 키
# (Gemini AI 호출에 필수 — 없으면 401 App Check 오류 발생)
VITE_RECAPTCHA_SITE_KEY=

# 선택: Gemini 모델명 직접 지정 (기본값 gemini-3.5-flash-lite, 실패 시 gemini-3.1-flash-lite로 자동 대체)
VITE_GEMINI_MODEL=
