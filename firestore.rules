rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isMemberOfGroup(groupId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    // users/{uid} — 본인만 자기 문서를 쓸 수 있음. 궁합/친구 검색을 위해
    // 로그인한 사용자끼리는 서로 읽을 수 있게 열어둠(이메일/성향 정도만 노출).
    // 관리자는 다른 유저의 aiUnlimited 필드를 바꾸거나, 계정을 삭제할 수 있음.
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aiUnlimited']);
      allow delete: if isAdmin();
    }

    // users/{uid}/private/{docId} — 본인만 읽고 쓸 수 있음 (궁합 주관식 답변 등 비공개 데이터).
    match /users/{uid}/private/{docId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // testNotifications/{id} — 본인 기기로 테스트 푸시를 요청하는 큐. 생성만 가능하고
    // 읽기/수정은 서버(GitHub Actions의 service account)만 함.
    match /testNotifications/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }

    // friendRequests/{id} — 친구 신청/수락 큐. 보낸 사람과 받은 사람만 읽을 수 있고,
    // 상태(status) 변경은 받은 사람만 가능(수락/거절). 삭제는 양쪽 다 가능(취소/정리용).
    match /friendRequests/{id} {
      allow read: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.toUid != request.auth.uid &&
        request.resource.data.status == "pending";
      allow update: if signedIn() && resource.data.toUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    // config/gemini — 관리자만 API 키를 읽고 쓸 수 있음 (일반 유저는 접근 불가).
    match /config/{docId} {
      allow read, write: if isAdmin();
    }

    // groups/{id} — 모임 멤버만 읽고 쓸 수 있음.
    match /groups/{id} {
      allow read, update, delete: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn() && request.auth.uid in request.resource.data.memberIds;
    }

    // schedules/{id} — 해당 일정이 속한 모임(그룹)의 멤버만 읽고 쓸 수 있음.
    // 삭제는 주최자만.
    match /schedules/{id} {
      allow read, update: if isMemberOfGroup(resource.data.groupId);
      allow create: if signedIn() &&
        request.resource.data.hostId == request.auth.uid &&
        isMemberOfGroup(request.resource.data.groupId);
      allow delete: if signedIn() && resource.data.hostId == request.auth.uid;
    }

    // personalSchedules/{id} — 모임 없이 혼자 등록하는 개인 머미 일정. 본인만 읽고 쓸 수 있음.
    match /personalSchedules/{id} {
      allow read, update, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
    }

    // records/{id} — 기본은 본인만 읽고 쓸 수 있음. 본인이 public:true로 공개한 감상평은
    // 같은 시나리오를 찾아보는 다른 유저도 읽을 수 있음(작성자가 명시적으로 공개한 것만).
    match /records/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || resource.data.public == true);
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
    }

    // scenarios/{id} — 승인된 시나리오는 누구나 볼 수 있음. 등록 요청은 누구나 만들 수 있고
    // status는 pending으로 시작, 관리자만 승인/거절(수정) 가능. 본인이 만든 요청은 본인이 삭제 가능.
    match /scenarios/{id} {
      allow read: if signedIn() && (resource.data.status == "approved" || isAdmin() || resource.data.submittedBy == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.submittedBy == request.auth.uid &&
        request.resource.data.status == "pending";
      allow update: if isAdmin();
      allow delete: if signedIn() && (isAdmin() || resource.data.submittedBy == request.auth.uid);
    }

    // 사건이 도착했습니다(caseSeasons/caseProgress/caseSubmissions/caseResults) — 정답/진상/
    // 판정기준이 문서 안에 공개 필드와 섞여 있어 필드 단위로 숨길 방법이 없음(Firestore 규칙은
    // 문서 단위 all-or-nothing). 그래서 이 기능은 전부 Cloud Functions(Admin SDK)를 통해서만
    // 접근하고, 클라이언트 직접 읽기/쓰기는 전면 차단한다. "if false"는 버그가 아님.
    match /caseSeasons/{seasonId}/{document=**} {
      allow read, write: if false;
    }
    match /caseProgress/{docId} {
      allow read, write: if false;
    }
    match /caseSubmissions/{docId} {
      allow read, write: if false;
    }
    match /caseResults/{docId} {
      allow read, write: if false;
    }
  }
}
